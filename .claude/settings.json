{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_data_json.py\"",
            "timeout": 10,
            "statusMessage": "Checking data JSON"
          }
        ]
      }
    ]
  }
}
