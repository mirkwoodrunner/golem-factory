<?xml version="1.0" encoding="utf-8"?>
<!--
  Godot.NET.Sdk and GodotSharp ship inside the Godot install, not on nuget.org at
  every version. The editor registers this folder in the user's NuGet config the
  first time it opens a C# project; declaring it here lets `dotnet build` and
  `dotnet test` work from a clean machine without opening the editor first.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="GodotSharp" value="G:\Godot_v4.7.2-stable_mono_win64\Godot_v4.7.2-stable_mono_win64\GodotSharp\Tools\nupkgs" />
  </packageSources>
</configuration>
