<Project Sdk="Microsoft.NET.Sdk">
  <!--
    NUnit 3, not 4: the Unity suite this is ported from uses the classic
    Assert.AreEqual / Assert.IsTrue forms, which NUnit 4 moved to a Legacy namespace.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GolemFactory.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/GolemFactory.Core.csproj" />
  </ItemGroup>
</Project>
