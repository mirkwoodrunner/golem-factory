<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>GolemFactory</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- Core and its tests are separate projects in subfolders; keep this project's
       default glob from compiling their sources a second time. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Core/**;Core.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Core/GolemFactory.Core.csproj" />
  </ItemGroup>

  <!-- An export (dotnet publish for a runtime, Linux on the Deck) compiles the game ahead of
       time, so a first open doesn't wait on the JIT (docs/steam-deck-design.md D8). The editor's
       and the tests' builds name no runtime, and stay as they were. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
